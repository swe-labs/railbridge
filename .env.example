# ==============================================================================
# Railbridge v1.0.0 Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_BASE_URL=http://localhost:8080

# Network Binding (Alwaysdata injects $IP and $PORT automatically in production)
IP=0.0.0.0
PORT=8080

# Database Storage Engine
# Production (Alwaysdata / VPS): postgres://user:pass@postgresql-railbridge.alwaysdata.net:5432/railbridge_db?sslmode=require
# Local Sandbox (Zero-Config): sqlite://./data/railbridge.db?_journal_mode=WAL
DATABASE_URL=sqlite://./data/railbridge.db?_journal_mode=WAL

# Master Encryption Key (32 bytes / 64 hex characters for AES-256-GCM tenant secret encryption)
# Generate via: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Transactional Email Engine Configuration (smtp | resend | brevo | postmark)
EMAIL_DRIVER=smtp
SMTP_HOST=smtp-railbridge.alwaysdata.net
SMTP_PORT=587
SMTP_USER=noreply@swe-labs.com
SMTP_PASS=your_smtp_password

# Transactional SMS Engine Configuration (android_bridge | greenweb | bulksmsbd | mimsms | twilio)
SMS_PRIMARY_DRIVER=android_bridge
SMS_FALLBACK_DRIVER=greenweb
ANDROID_BRIDGE_SECRET=change_me_to_strong_secret_token
GREENWEB_API_TOKEN=your_greenweb_api_token
